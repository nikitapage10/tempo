{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tempo-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "tempo-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tempo-dev-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "tempo-dev-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3200,
      "autoPort": true
    },
    {
      "name": "tempo-test-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:test"
      ],
      "port": 3200
    }
  ]
}