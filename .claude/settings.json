{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -x \"$d/.claude/hooks/check-release-rules.sh\" ] && \"$d/.claude/hooks/check-release-rules.sh\" || true",
            "timeout": 15,
            "statusMessage": "Checking release rules…"
          }
        ]
      }
    ]
  }
}
