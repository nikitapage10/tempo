# Copy this file to .env.local and fill in values from
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never expose to the browser, never commit, never log.
# Supabase → Project Settings → API → "service_role" secret. Required for
# guest review links (/review, /api/review/*) to validate tokens and sign
# playback/download URLs. See DEPLOYMENT.md and SECURITY-AND-PERMISSIONS.md.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# SERVER ONLY — branded program invitations are delivered through Resend.
# Verify the sender domain in Resend, then use a full sender such as:
# INVITE_FROM_EMAIL=TEMPO <invites@your-domain.com>
RESEND_API_KEY=
INVITE_FROM_EMAIL=

# SERVER ONLY — signing secret for Resend's outbound webhook (delivered/
# bounced/complained events for Pulse digest email). Resend dashboard ->
# Webhooks -> your endpoint -> Signing Secret. Never expose to the browser.
# The webhook route responds 501 (not configured) rather than failing open
# if this is unset.
RESEND_WEBHOOK_SECRET=

# Optional. Production auth/PWA links default to https://tempo-ten-sigma.vercel.app
# NEXT_PUBLIC_SITE_URL=https://tempo-ten-sigma.vercel.app

# Optional public Windows installer URL. Keep unset until the public desktop
# release repository has a verified release; the app falls back to the bundled
# 0.100.6 beta installer. Production value after setup:
# NEXT_PUBLIC_DESKTOP_WINDOWS_URL=https://github.com/nikitapage10/tempo-desktop-releases/releases/latest/download/TEMPO-Setup.exe

# SERVER ONLY — the shared invite code required to create a new account at
# /register. Never expose to the browser, never commit, never log. Give this
# out to whoever you want to let in; anyone without it sees "Request an
# invite" instead of a working form. Leave unset to keep signups closed.
INVITE_CODE=

# Optional starter community for invited first-run accounts. List up to six
# published artist handles in the order they should appear. When omitted,
# TEMPO uses published profiles owned by the inviter, team members, and admins.
ONBOARDING_DEMO_PROFILE_HANDLES=
ONBOARDING_DEMO_SCENE_SLUG=tempo-green-room

# Lightfield kill-switch: set to "off" to render .flare-static instead of WebGL
# NEXT_PUBLIC_LIGHTFIELD=off

# LOCAL DEVELOPMENT ONLY — the address /api/dev/session signs in as, so UI work
# (and automated browsers) can reach the authenticated screens without typing a
# password into the login form. The user is created on first use.
#
# Do NOT set this in Vercel. The route additionally requires NODE_ENV to be
# "development" and the request host to be loopback, so it 404s in a deployed
# build either way — but leaving it unset there is the simplest guarantee.
# Point it at a throwaway address, never your real account.
DEV_TEST_EMAIL=

# SERVER ONLY — used by the AI onboarding/import feature to parse chat/photos/
# uploads into tracks. Never expose to the browser, never commit, never log.
OPENAI_API_KEY=

# Optional model overrides for Import Studio. Defaults shown.
# gpt-5.6-sol = frontier (messier catalogs), gpt-5.6-luna = cheapest.
# OPENAI_IMPORT_MODEL=gpt-5.6-terra
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# SERVER ONLY — authorizes Vercel Cron + manual curls for nightly catalog
# metadata snapshots (/api/cron/catalog-snapshots). Never expose to the browser.
CRON_SECRET=
# SERVER ONLY — platform stats on the Artist page. Never expose to the
# browser, never commit, never log.
#
# These are APP-level credentials, not per-artist: one pair serves every
# TEMPO user, because both platforms are read through the client-credentials
# flow, which only ever reads public profile data. An artist using TEMPO just
# pastes their profile URL — they never need a developer account.
#
# Spotify: create an app at https://developer.spotify.com/dashboard (free).
# Gives public artist/release/track metadata for catalog matching. Streams,
# monthly listeners, followers and popularity are not available here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Market used while enumerating an artist catalog (ISO country code).
SPOTIFY_MARKET=US
# Safety ceiling for primary albums/singles read during a full catalog import.
# Defaults to 250 and is clamped between 10 and 500.
SPOTIFY_MAX_CATALOG_RELEASES=250

# SoundCloud: register at https://developers.soundcloud.com/docs/api/register-app
# (needs an Artist Pro subscription on the account that registers the app).
# Gives plays, likes, reposts and followers as current totals; TEMPO snapshots
# them daily to build the history SoundCloud doesn't expose.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Apple Music needs no keys — the Artist page uses the free iTunes Search API,
# which is catalog only. Real Apple Music stats require the paid Apple
# Developer Program, so they are deliberately not used.
