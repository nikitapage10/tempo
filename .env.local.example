# Copy this file to .env.local and fill in values from
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never expose to the browser, never commit, never log.
# Supabase → Project Settings → API → "service_role" secret. Required for
# guest review links (/review, /api/review/*) to validate tokens and sign
# playback/download URLs. See DEPLOYMENT.md and SECURITY-AND-PERMISSIONS.md.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Production auth/PWA links default to https://tempo-ten-sigma.vercel.app
# NEXT_PUBLIC_SITE_URL=https://tempo-ten-sigma.vercel.app

# SERVER ONLY — the shared invite code required to create a new account at
# /register. Never expose to the browser, never commit, never log. Give this
# out to whoever you want to let in; anyone without it sees "Request an
# invite" instead of a working form. Leave unset to keep signups closed.
INVITE_CODE=

# Lightfield kill-switch: set to "off" to render .flare-static instead of WebGL
# NEXT_PUBLIC_LIGHTFIELD=off

# SERVER ONLY — used by the AI onboarding/import feature to parse chat/photos/
# uploads into tracks. Never expose to the browser, never commit, never log.
OPENAI_API_KEY=

# Optional model overrides for Import Studio. Defaults shown.
# gpt-5.6-sol = frontier (messier catalogs), gpt-5.6-luna = cheapest.
# OPENAI_IMPORT_MODEL=gpt-5.6-terra
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# SERVER ONLY — platform stats on the Artist page. Never expose to the
# browser, never commit, never log.
#
# These are APP-level credentials, not per-artist: one pair serves every
# TEMPO user, because both platforms are read through the client-credentials
# flow, which only ever reads public profile data. An artist using TEMPO just
# pastes their profile URL — they never need a developer account.
#
# Spotify: create an app at https://developer.spotify.com/dashboard (free).
# Gives followers, popularity and top tracks. Streams and monthly listeners
# are NOT available to any app — only Spotify for Artists has those.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SoundCloud: register at https://developers.soundcloud.com/docs/api/register-app
# (needs an Artist Pro subscription on the account that registers the app).
# Gives plays, likes, reposts and followers as current totals; TEMPO snapshots
# them daily to build the history SoundCloud doesn't expose.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Apple Music needs no keys — the Artist page uses the free iTunes Search API,
# which is catalog only. Real Apple Music stats require the paid Apple
# Developer Program, so they are deliberately not used.
