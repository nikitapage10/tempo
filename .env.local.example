# Copy this file to .env.local and fill in values from
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never expose to the browser, never commit, never log.
# Supabase → Project Settings → API → "service_role" secret. Required for
# guest review links (/review, /api/review/*) to validate tokens and sign
# playback/download URLs. See DEPLOYMENT.md and SECURITY-AND-PERMISSIONS.md.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Production auth/PWA links default to https://tempo-ten-sigma.vercel.app
# NEXT_PUBLIC_SITE_URL=https://tempo-ten-sigma.vercel.app

# Lightfield kill-switch: set to "off" to render .flare-static instead of WebGL
# NEXT_PUBLIC_LIGHTFIELD=off
