{
  "name": "tempo-desktop",
  "version": "0.100.19",
  "private": true,
  "description": "TEMPO — Electron shell. Deliberately its own package, separate from the root TEMPO package.json, so Vercel's web deploy never installs Electron's Chromium binary. Run `npm install` inside this folder before desktop:dev / desktop:build from the repo root.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikitapage10/tempo.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tempo.desktop",
    "productName": "TEMPO",
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "media-permissions.js",
      "oauth-navigation.js",
      "preload.js",
      "vault.js",
      "vault-media-response.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public/tempo-emblem.png",
        "to": "assets/tempo-icon.png"
      },
      {
        "from": "../public/tempo-icon.ico",
        "to": "assets/tempo-icon.ico"
      },
      {
        "from": "../public/tempo-tray-16.png",
        "to": "assets/tempo-tray-16.png"
      },
      {
        "from": "../public/tempo-tray-32.png",
        "to": "assets/tempo-tray-32.png"
      }
    ],
    "extraMetadata": {
      "version": "0.100.19"
    },
    "protocols": [
      {
        "name": "TEMPO",
        "schemes": [
          "tempo"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../public/tempo-icon.ico",
      "artifactName": "TEMPO-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../public/tempo-icon.ico",
      "uninstallerIcon": "../public/tempo-icon.ico",
      "installerHeaderIcon": "../public/tempo-icon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "include": "installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TEMPO",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "warningsAsErrors": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "artifactName": "TEMPO-Mac.${ext}",
      "icon": "../public/tempo-emblem.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TEMPO uses your microphone for dictation and voice notes when you choose to record."
      }
    },
    "publish": {
      "provider": "github",
      "owner": "nikitapage10",
      "repo": "tempo-desktop-releases",
      "releaseType": "release"
    }
  }
}
