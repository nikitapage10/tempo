{
  "crons": [
    {
      "path": "/api/cron/catalog-snapshots",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/reconcile-product-events",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/pulse-dispatch",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/onboarding/origin/:path*.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/intro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
